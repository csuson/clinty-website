VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SSL_CERT_PATH=~/Downloads/prod-ca-2021.crt
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_SQUARE_APPLICATION_ID=your-square-application-id
VITE_SQUARE_SANDBOX=false
VITE_STRIPE_CONNECT_CLIENT_ID=ca_your-stripe-connect-client-id
# VITE_STRIPE_REDIRECT_URI=https://clinty.net/account/integrations/stripe/callback  (optional override)
VITE_YAHOO_CLIENT_ID=your-yahoo-client-id
VITE_ADMIN_EMAILS=you@example.com
VITE_AD_CAMPAIGN_API_URL=https://your-campaign-agent.onrender.com
# VITE_SITE_URL=https://clinty.net  (canonical URLs for SEO — defaults to https://clinty.net)

# Supabase Edge Function secrets (not in .env — set in Supabase dashboard):
# STRIPE_SECRET_KEY=sk_...  (platform secret — match test/live to client ID mode)
# STRIPE_CONNECT_CLIENT_ID=ca_...  (optional — if set, should match VITE_STRIPE_CONNECT_CLIENT_ID)
# Enable OAuth: Stripe Dashboard → Settings → Connect → Onboarding options → OAuth
#   https://dashboard.stripe.com/settings/connect/onboarding-options/oauth
#   1) Turn on "Enable OAuth"
#   2) Copy Client ID (test vs live via Dashboard Test mode toggle)
#   3) Add redirect URIs:
#      https://clinty.net/account/integrations/stripe/callback
#      http://localhost:5173/account/integrations/stripe/callback  (local dev)
# Deploy Stripe Connect (after setting secrets):
#   npm run supabase -- db push
#   npm run supabase -- functions deploy stripe-oauth-exchange
#   npm run supabase -- functions deploy stripe-oauth-disconnect
#   npm run supabase -- functions deploy admin-data
#   npm run supabase -- functions deploy admin-delete
#   npm run supabase -- functions deploy agent-settings
# META_APP_SECRET=...  (Meta OAuth + mandatory Data Deletion Request callback)
# Meta App Dashboard → Settings → Data Deletion Requests → Callback URL:
#   https://clinty.net/webhooks/meta-data-deletion
# VITE_SHOPIFY_CLIENT_ID=your-shopify-app-client-id
# VITE_SHOPIFY_REDIRECT_URI=https://clinty.net/account/integrations/shopify/callback  (optional override)
# SHOPIFY_CLIENT_SECRET=...  (Shopify OAuth + mandatory compliance webhooks — Supabase Edge Function secrets)
# SHOPIFY_CLIENT_ID=your-shopify-app-client-id  (optional — if set, must match VITE_SHOPIFY_CLIENT_ID)
# Shopify Partner Dashboard → Configuration → Allowed redirection URL(s):
#   https://clinty.net/account/integrations/shopify/callback
#   http://localhost:5173/account/integrations/shopify/callback  (local dev)
# Shopify Partner Dashboard → Compliance webhooks (all three topics):
#   https://clinty.net/webhooks/shopify-compliance
#   (proxies to Supabase functions/v1/shopify-compliance — do NOT use the site root URL)
# AD_CAMPAIGN_API_URL=https://your-campaign-agent.onrender.com  (shared agent for every Clinty account)
# EMAIL_ASSISTANT_API_URL=https://your-email-assistant.onrender.com  (analytics fallback when Agent Settings URL is empty)
# Shopify Storefront domain + token are saved on Integrations and returned by agent-settings.
# WHATSAPP_WEB_GATEWAY_URL=https://your-gateway-host:8787
# WHATSAPP_WEB_LOGIN_API_KEY=your-clinty-api-key
# WHATSAPP_WEB_DEBUG=1
# WHATSAPP_WEB_AUTH_BACKEND=supabase
# WHATSAPP_WEB_AUTH_BUCKET=whatsapp-web-auth
# WHATSAPP_WEB_AUTH_STORAGE_PREFIX=default
# WHATSAPP_WEB_AUTH_DIR=/tmp/whatsapp-web-auth
# OPENAI_API_KEY=sk-...  (required for Generate background from website on Prompts page)
# RESEND_API_KEY=re_...  (transactional email for AI usage alerts at 90% / 100%)
# TRANSACTIONAL_FROM_EMAIL=Clinty <notifications@clinty.net>

# Hostinger FTP deploy (optional — for npm run deploy:hostinger)
HOSTINGER_FTP_HOST=ftp.yourdomain.com
HOSTINGER_FTP_USER=your-ftp-username
HOSTINGER_FTP_PASSWORD=your-ftp-password
HOSTINGER_FTP_REMOTE_PATH=/domains/clinty.net/public_html
HOSTINGER_FTP_SECURE=true
