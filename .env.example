VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SSL_CERT_PATH=~/Downloads/prod-ca-2021.crt
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_MICROSOFT_CLIENT_ID=your-microsoft-application-client-id
VITE_SQUARE_APPLICATION_ID=your-square-application-id
VITE_SHOPIFY_CLIENT_ID=your-shopify-app-client-id
VITE_SQUARE_SANDBOX=false
VITE_ADMIN_EMAILS=you@example.com

# Google Ads campaign agent (optional — local Vite proxies /api/ad-campaigns → this URL)
# VITE_AD_CAMPAIGN_API_URL=http://127.0.0.1:8100

# Supabase Edge Function secrets (not in .env — set in Supabase dashboard):
# WHATSAPP_WEB_GATEWAY_URL / WHATSAPP_WEB_LOGIN_API_KEY — optional global fallback; users configure per-account gateways in Integrations
# OPENAI_API_KEY=sk-...  (required for Generate background from website on Prompts page)
# MICROSOFT_CLIENT_SECRET=...  (Outlook OAuth — set with MICROSOFT_CLIENT_ID in Supabase secrets)
# SHOPIFY_CLIENT_SECRET=...  (Shopify OAuth — set with SHOPIFY_CLIENT_ID in Supabase secrets)

# Hostinger FTP deploy (optional — for npm run deploy:hostinger)
HOSTINGER_FTP_HOST=ftp.yourdomain.com
HOSTINGER_FTP_USER=your-ftp-username
HOSTINGER_FTP_PASSWORD=your-ftp-password
HOSTINGER_FTP_REMOTE_PATH=/domains/clinty.net/public_html
HOSTINGER_FTP_SECURE=true
